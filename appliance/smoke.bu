variant: flatcar
version: 1.1.0
ignition:
  config:
    merge:
      - local: appliance.ign
systemd:
  units:
    - name: rightsizer.service
      dropins:
        - name: 90-ci-console.conf
          contents: |
            [Service]
            StandardOutput=tty
            StandardError=tty
            TTYPath=/dev/ttyS0
    - name: rightsizer-upgrade.service
      dropins:
        - name: 90-ci-console.conf
          contents: |
            [Service]
            StandardOutput=tty
            StandardError=tty
            TTYPath=/dev/ttyS0
    # Test-only triggers: a TCP connection writes the same request files the
    # console writes, so CI can drive an upgrade and a restart from outside.
    - name: rightsizer-ci-upgrade.socket
      enabled: true
      contents: |
        [Socket]
        ListenStream=9901
        Accept=yes
        [Install]
        WantedBy=sockets.target
    - name: rightsizer-ci-upgrade@.service
      contents: |
        [Service]
        StandardInput=socket
        ExecStart=/bin/sh -c 'printf "v0.0.1\\n" >/var/lib/rightsizer/data/host/upgrade-request'
    - name: rightsizer-ci-reboot.socket
      enabled: true
      contents: |
        [Socket]
        ListenStream=9902
        Accept=yes
        [Install]
        WantedBy=sockets.target
    - name: rightsizer-ci-reboot@.service
      contents: |
        [Service]
        StandardInput=socket
        ExecStart=/bin/sh -c 'printf "reboot\\n" >/var/lib/rightsizer/data/host/reboot-request'
storage:
  files:
    - path: /etc/rightsizer/ovfenv.xml
      mode: 0600
      contents:
        inline: |
          <?xml version="1.0" encoding="UTF-8"?>
          <Environment xmlns="http://schemas.dmtf.org/ovf/environment/1" xmlns:oe="http://schemas.dmtf.org/ovf/environment/1">
            <PropertySection>
              <Property oe:key="guestinfo.hostname" oe:value="rightsizer-ci"/>
              <Property oe:key="guestinfo.rightsizer.admin_password" oe:value="ci &amp; admin password"/>
              <Property oe:key="guestinfo.rightsizer.update_check" oe:value="False"/>
              <Property oe:key="guestinfo.rightsizer.timezone" oe:value="Europe/Rome"/>
            </PropertySection>
          </Environment>
