#!/usr/bin/env bash
# rightsizer appliance host helper. Runs as root from systemd units only.
set -euo pipefail
umask 077

REGISTRY=ghcr.io/marcocolomb0/rightsizer
ENV_FILE=/etc/rightsizer/engine.env
STATE=/var/lib/rightsizer
DATA=$STATE/data
BACKUPS=$STATE/backups
UID_ENGINE=65532
C=rightsizer

log() { echo "rightsizer-host: $*" >&2; }

ovfenv() {
	if [ -r /etc/rightsizer/ovfenv.xml ]; then
		cat /etc/rightsizer/ovfenv.xml
		return
	fi
	local t
	for t in /usr/share/oem/bin/vmtoolsd /oem/bin/vmtoolsd vmtoolsd; do
		if command -v "$t" >/dev/null 2>&1; then
			"$t" --cmd 'info-get guestinfo.ovfEnv' 2>/dev/null && return
		fi
	done
	for t in /usr/share/oem/bin/vmware-rpctool /oem/bin/vmware-rpctool vmware-rpctool; do
		if command -v "$t" >/dev/null 2>&1; then
			"$t" 'info-get guestinfo.ovfEnv' 2>/dev/null && return
		fi
	done
}

OVF=""
prop() {
	[ -n "$OVF" ] || OVF="$(ovfenv || true)"
	grep -o "oe:key=\"guestinfo.$1\" oe:value=\"[^\"]*\"" <<<"$OVF" | head -n1 |
		sed -e 's/.*oe:value="//' -e 's/"$//' \
			-e 's/&lt;/</g' -e 's/&gt;/>/g' -e 's/&quot;/"/g' -e "s/&apos;/'/g" -e 's/&amp;/\&/g' || true
}

valid() { [[ "$2" =~ $1 ]]; }
IP='^([0-9]{1,3}\.){3}[0-9]{1,3}$'
CIDR='^([0-9]{1,3}\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$'
NAME='^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$'

network() {
	local host ip gw dns domain ntp tz f=/etc/systemd/network/00-rightsizer.network
	host="$(prop hostname)"
	ip="$(prop rightsizer.ip)"
	gw="$(prop rightsizer.gateway)"
	dns="$(prop rightsizer.dns | tr ',;' '  ')"
	domain="$(prop rightsizer.domain)"
	ntp="$(prop rightsizer.ntp | tr ',;' '  ')"
	tz="$(prop rightsizer.timezone)"

	if [ -n "$host" ] && valid "$NAME" "$host"; then
		printf '%s\n' "$host" >/etc/hostname
		chmod 0644 /etc/hostname
		hostname "$host"
	fi
	{
		echo "[Match]"
		echo "Name=en* eth*"
		echo "[Network]"
		echo "LinkLocalAddressing=no"
		echo "IPv6AcceptRA=no"
		if [ -n "$ip" ] && valid "$CIDR" "$ip"; then
			echo "DHCP=no"
			echo "Address=$ip"
			if valid "$IP" "$gw"; then echo "Gateway=$gw"; fi
		else
			[ -z "$ip" ] || log "ignoring invalid IP address '$ip', using DHCP"
			echo "DHCP=ipv4"
		fi
		for d in $dns; do
			if valid "$IP" "$d"; then echo "DNS=$d"; fi
		done
		if [ -n "$domain" ] && valid "$NAME" "$domain"; then echo "Domains=$domain"; fi
	} >"$f.tmp"
	chmod 0644 "$f.tmp"
	mv "$f.tmp" "$f"

	local servers=""
	for s in $ntp; do
		if valid "$NAME" "$s" || valid "$IP" "$s"; then servers="$servers $s"; fi
	done
	mkdir -p /etc/systemd/timesyncd.conf.d
	if [ -n "$servers" ]; then
		printf '[Time]\nNTP=%s\n' "${servers# }" >/etc/systemd/timesyncd.conf.d/rightsizer.conf
	else
		rm -f /etc/systemd/timesyncd.conf.d/rightsizer.conf
	fi
	chmod 0644 /etc/systemd/timesyncd.conf.d/rightsizer.conf 2>/dev/null || true

	if [ -n "$tz" ] && valid '^[A-Za-z0-9/_+-]+$' "$tz" && [ -e "/usr/share/zoneinfo/$tz" ]; then
		ln -sfn "../usr/share/zoneinfo/$tz" /etc/localtime
	fi
	guest_info
}

# admin_password applies the vApp password on first boot, and again only when
# it is changed in vCenter (a reset: stored vCenter credentials are cleared).
admin_password() {
	local pw key seen
	pw="$(prop rightsizer.admin_password)"
	[ -n "$pw" ] || return 0
	[ -s "$STATE/key" ] || head -c 32 /dev/urandom | base64 >"$STATE/key"
	key="$(cat "$STATE/key")"
	seen="$(printf '%s:%s' "$key" "$pw" | sha256sum | cut -d' ' -f1)"
	if [ "$(cat "$STATE/admin-password.applied" 2>/dev/null)" = "$seen" ]; then
		return 0
	fi
	install -d -m 0700 -o "$UID_ENGINE" -g "$UID_ENGINE" "$DATA/bootstrap"
	printf '%s\n' "$pw" >"$DATA/bootstrap/admin-password"
	chown "$UID_ENGINE:$UID_ENGINE" "$DATA/bootstrap/admin-password"
	chmod 0600 "$DATA/bootstrap/admin-password"
	echo "$seen" >"$STATE/admin-password.applied"
	log "administrator password from vApp options will be applied"
}

# guest_info sets what VMware Tools reports to vCenter as the guest OS:
# the appliance name and versions, with the short name matching the VM's
# configured guest type so vCenter shows no mismatch.
guest_info() {
	local f=/etc/rightsizer/vmware-tools.conf tag os tmp
	tag="$(sed -n 's/^IMAGE=.*:\([0-9A-Za-z._-]*\)$/\1/p' "$ENV_FILE" 2>/dev/null | head -n1)"
	os="$(sed -n 's/^VERSION=//p' /etc/os-release 2>/dev/null | tr -d '"' | head -n1)"
	valid '^[0-9A-Za-z._-]+$' "$tag" || tag="unknown"
	valid '^[0-9A-Za-z._-]+$' "$os" || os=""
	install -d -m 0755 /etc/rightsizer
	tmp="$(mktemp)"
	{
		echo "# Managed by rightsizer-host."
		echo "[guestosinfo]"
		echo "short-name=other4xlinux-64"
		echo "long-name=rightsizer appliance v${tag#v} (Flatcar Container Linux ${os:-})"
	} >"$tmp"
	if [ "${1:-}" != "force" ] && cmp -s "$tmp" "$f"; then
		rm -f "$tmp"
		return 0
	fi
	chmod 0644 "$tmp"
	mv -f "$tmp" "$f"
	systemctl try-restart vmtoolsd.service 2>/dev/null || true
}

image() {
	# shellcheck disable=SC1090
	. "$ENV_FILE"
	echo "$IMAGE"
}

load_bundle() {
	local img mnt=/run/rightsizer-bundle
	img="$(image)"
	docker image inspect "$img" >/dev/null 2>&1 && return 0
	if [ -e /dev/disk/by-label/RSBUNDLE ]; then
		mkdir -p "$mnt"
		mount -o ro,nodev,nosuid,noexec /dev/disk/by-label/RSBUNDLE "$mnt"
		for t in "$mnt"/rightsizer-image*.tar.gz; do
			[ -f "$t" ] && { docker load -i "$t" >/dev/null || true; }
		done
		umount "$mnt"
	fi
	docker image inspect "$img" >/dev/null 2>&1 || docker pull -q "$img" >/dev/null
}

install_console() {
	local img tmp
	img="$(image)"
	tmp="$(docker create "$img" console)"
	install -d -m 0755 /opt/rightsizer/bin
	docker cp "$tmp:/rightsizer" /opt/rightsizer/bin/rightsizer.new
	docker rm "$tmp" >/dev/null
	chmod 0755 /opt/rightsizer/bin/rightsizer.new
	mv /opt/rightsizer/bin/rightsizer.new /opt/rightsizer/bin/rightsizer
}

prepare() {
	# Traverse-only, so the console user can reach its data directory without
	# listing or reading the root-owned files next to it.
	install -d -m 0711 "$STATE"
	chmod 0711 "$STATE"
	install -d -m 0700 "$BACKUPS"
	install -d -m 0700 -o "$UID_ENGINE" -g "$UID_ENGINE" "$DATA" "$DATA/host"
	chown "$UID_ENGINE:$UID_ENGINE" "$BACKUPS"
	admin_password
	load_bundle
	install_console
	guest_info
}

UNIT='^[a-z0-9@.-]+\.(service|socket|path|timer|target)$'
OWN_UNIT='^rightsizer[a-z0-9-]*\.(service|path|timer)$'
KARG='^-?[A-Za-z0-9._=,-]+$'
HOST_PATHS='^/(opt/rightsizer/bin/[a-z0-9-]+|etc/systemd/system/rightsizer[a-z0-9-]*\.(service|path|timer)|etc/systemd/system/vmtoolsd\.service\.d/10-rightsizer\.conf|etc/sysctl\.d/90-rightsizer\.conf|etc/systemd/logind\.conf\.d/10-rightsizer\.conf|etc/docker/daemon\.json|etc/flatcar/update\.conf)$'
PREVIOUS=$STATE/host-previous

# replace installs a file atomically: a running copy of this script keeps
# reading the old inode, so the helper can safely replace itself.
replace() {
	local src="$1" dst="$2" mode="$3"
	install -d -m 0755 "$(dirname "$dst")"
	cp "$src" "$dst.rightsizer-new"
	chown root:root "$dst.rightsizer-new"
	chmod "$mode" "$dst.rightsizer-new"
	mv -f "$dst.rightsizer-new" "$dst"
}

ensure_user() {
	getent group rightsizer >/dev/null || groupadd --system --gid "$UID_ENGINE" rightsizer
	getent passwd rightsizer >/dev/null ||
		useradd --system --uid "$UID_ENGINE" --gid rightsizer --no-create-home --home-dir / --shell /sbin/nologin rightsizer
}

reboot_flag() {
	local dir="$DATA/host/reboot" f
	install -d -m 0700 -o "$UID_ENGINE" -g "$UID_ENGINE" "$dir"
	f="$dir/$1.json"
	printf '{"Text":"%s","BootID":"%s","Since":"%s"}\n' "$2" "$(cat /proc/sys/kernel/random/boot_id)" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$f.tmp"
	chown "$UID_ENGINE:$UID_ENGINE" "$f.tmp"
	chmod 0600 "$f.tmp"
	mv "$f.tmp" "$f"
}

clear_flag() { rm -f "$DATA/host/reboot/$1.json"; }

# grub_cfg prints Flatcar's OEM grub.cfg, mounting the OEM partition if the
# running system does not have it mounted.
grub_cfg() {
	local f mnt=/run/rightsizer-oem
	for f in /oem/grub.cfg /usr/share/oem/grub.cfg "$mnt/grub.cfg"; do
		[ -f "$f" ] && { echo "$f"; return 0; }
	done
	[ -e /dev/disk/by-label/OEM ] || return 1
	mkdir -p "$mnt"
	mount /dev/disk/by-label/OEM "$mnt" 2>/dev/null || return 1
	[ -f "$mnt/grub.cfg" ] || touch "$mnt/grub.cfg"
	echo "$mnt/grub.cfg"
}

# kernel_args makes the kernel command line match the arguments given (-arg:
# must be absent). It returns 0 when grub.cfg changed and a restart is needed.
kernel_args() {
	local cfg tmp a e want=() missing=()
	cfg="$(grub_cfg)" || { log "OEM grub.cfg not found; kernel settings not changed"; return 1; }
	log "kernel settings: checking $cfg for: $*"
	tmp="$(mktemp)"
	cp "$cfg" "$tmp"
	sed -i '/^# BEGIN rightsizer/,/^# END rightsizer/d' "$tmp"
	for a in "$@"; do
		valid "$KARG" "$a" || continue
		e="${a#-}"
		e="${e//./\\.}"
		if [[ "$a" == -* ]]; then
			sed -i -E "/linux_append/ s/(^|[\" ])${e}([\" ]|$)/\1\2/g" "$tmp"
		else
			want+=("$a")
		fi
	done
	for a in "${want[@]}"; do
		e="${a//./\\.}"
		grep 'linux_append' "$tmp" | grep -Eq "(^|[\" ])${e}([\" ]|$)" || missing+=("$a")
	done
	if [ "${#missing[@]}" -gt 0 ]; then
		{
			echo "# BEGIN rightsizer (managed by rightsizer-host, do not edit)"
			echo "set linux_append=\"\$linux_append ${missing[*]}\""
			echo "# END rightsizer"
		} >>"$tmp"
	fi
	if cmp -s "$tmp" "$cfg"; then
		rm -f "$tmp"
		log "kernel settings already as required"
		return 1
	fi
	cp "$tmp" "$cfg.rightsizer-new"
	chmod 0644 "$cfg.rightsizer-new"
	mv -f "$cfg.rightsizer-new" "$cfg"
	rm -f "$tmp"
	log "kernel settings changed in $cfg"
	return 0
}

# apply installs an appliance host bundle (see appliance/host/manifest) and
# records everything it replaced in $2 so that restore_host can undo it.
apply() {
	local dir="$1" prev="$2" kind a b src reasons=() changed=() enable=() mask=() kargs=()
	[ -f "$dir/manifest" ] || { log "bundle has no manifest"; return 1; }
	rm -rf "$prev"
	install -d -m 0700 "$prev"
	: >"$prev/list"
	while read -r kind a b; do
		case "$kind" in
		"" | \#*) continue ;;
		file)
			if ! valid "$HOST_PATHS" "$b" || ! valid '^0(644|755)$' "$a"; then
				log "bundle entry not allowed: $a $b"
				return 1
			fi
			src="$dir/root$b"
			if [ ! -f "$src" ] || [ -L "$src" ]; then
				log "bundle file missing: $b"
				return 1
			fi
			if [ -f "$b" ] && cmp -s "$src" "$b"; then
				continue
			fi
			if [ -e "$b" ]; then
				install -d -m 0700 "$prev/files$(dirname "$b")"
				cp -p "$b" "$prev/files$b"
				echo "restore $b" >>"$prev/list"
			else
				echo "remove $b" >>"$prev/list"
			fi
			replace "$src" "$b" "$a"
			changed+=("$b")
			;;
		enable)
			valid "$OWN_UNIT" "$a" || { log "bundle unit not allowed: $a"; return 1; }
			enable+=("$a")
			;;
		mask)
			valid "$UNIT" "$a" || { log "bundle unit not allowed: $a"; return 1; }
			mask+=("$a")
			;;
		kernel)
			valid "$KARG" "$a" || { log "bundle kernel argument not allowed: $a"; return 1; }
			kargs+=("$a")
			;;
		*)
			log "unknown bundle entry: $kind"
			return 1
			;;
		esac
	done <"$dir/manifest"

	ensure_user
	systemctl daemon-reload
	for a in "${mask[@]}"; do systemctl mask "$a" >/dev/null 2>&1 || true; done
	for a in "${enable[@]}"; do
		systemctl enable "$a" >/dev/null 2>&1 || true
		case "$a" in *.path | *.timer) systemctl restart "$a" || true ;; esac
	done
	for a in "${changed[@]}"; do
		case "$a" in
		*/sysctl.d/*) sysctl --system >/dev/null || true ;;
		*/flatcar/update.conf) systemctl try-restart update-engine.service locksmithd.service 2>/dev/null || true ;;
		*/vmtoolsd.service.d/*) guest_info force ;;
		*/docker/daemon.json) reasons+=("Docker settings changed") ;;
		*/logind.conf.d/*) reasons+=("console settings changed") ;;
		esac
	done
	if kernel_args "${kargs[@]}"; then
		reasons+=("kernel settings changed")
	fi
	if [ "${#reasons[@]}" -gt 0 ]; then
		local IFS=", "
		reboot_flag upgrade "Appliance updated: ${reasons[*]}"
	fi
	log "appliance host layer applied (${#changed[@]} files changed)"
}

restore_host() {
	local prev="$1" action path
	[ -f "$prev/list" ] || return 0
	while read -r action path; do
		case "$action" in
		restore) [ -f "$prev/files$path" ] && mv -f "$prev/files$path" "$path" ;;
		remove) rm -f "$path" ;;
		esac
	done <"$prev/list"
	systemctl daemon-reload
	log "appliance host layer restored"
}

os_check() {
	local st op ver
	st="$(update_engine_client -status 2>/dev/null || true)"
	op="$(sed -n 's/^CURRENT_OP=//p' <<<"$st")"
	ver="$(sed -n 's/^NEW_VERSION=//p' <<<"$st")"
	valid '^[0-9][0-9.]*$' "$ver" || ver=""
	if [ "$op" = "UPDATE_STATUS_UPDATED_NEED_REBOOT" ]; then
		reboot_flag os "Flatcar OS update ${ver:-} installed"
	else
		clear_flag os
	fi
}

reboot_host() {
	local req="$DATA/host/reboot-request"
	[ -f "$req" ] || return 0
	if [ "$(head -c 16 "$req" | tr -d '\n')" != "reboot" ]; then
		rm -f "$req"
		log "ignoring invalid restart request"
		return 0
	fi
	rm -f "$req"
	log "restart requested from the console"
	systemctl stop rightsizer.service || true
	systemctl reboot
}

public_ip() {
	ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "src") { print $(i + 1); exit }}'
}

engine() {
	local img check
	img="$(image)"
	case "$(prop rightsizer.update_check)" in
	False | false) check=false ;;
	*) check=true ;;
	esac
	docker rm -f "$C" >/dev/null 2>&1 || true
	exec docker run --rm --name "$C" \
		--read-only \
		--cap-drop ALL \
		--security-opt no-new-privileges:true \
		--pids-limit 256 \
		--memory 1536m \
		--tmpfs /tmp:rw,noexec,nosuid,size=16m \
		-p 22:2222 -p 443:8443 \
		-e RIGHTSIZER_APPLIANCE=1 \
		-e RIGHTSIZER_PUBLIC_HOST="$(public_ip)" \
		-e RIGHTSIZER_PUBLIC_PORT=443 \
		-e RIGHTSIZER_UPDATE_CHECK="$check" \
		-e TZ="$(readlink /etc/localtime 2>/dev/null | sed -n 's|.*zoneinfo/||p' | grep -E '^[A-Za-z0-9/_+-]+$' || echo UTC)" \
		-v "$DATA":/data \
		"$img" daemon
}

status() {
	local tmp="$DATA/host/.upgrade-status.json"
	printf '{"Version":"%s","State":"%s","Message":"%s","Time":"%s"}\n' "$1" "$2" "${3:-}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$tmp"
	chown "$UID_ENGINE:$UID_ENGINE" "$tmp"
	mv "$tmp" "$DATA/host/upgrade-status.json"
}

count() { docker exec "$C" /rightsizer status 2>/dev/null | awk 'NR == 1 && $1 == "sources:" {print $2}'; }

ready() {
	for _ in $(seq 1 90); do
		docker exec "$C" /rightsizer status >/dev/null 2>&1 && return 0
		sleep 1
	done
	return 1
}

upgrade() {
	local req="$DATA/host/upgrade-request" tag old new before after file bundle tmp
	[ -f "$req" ] || return 0
	tag="$(head -c 32 "$req" | tr -d '\n')"
	rm -f "$req"
	if ! valid '^v[0-9]+\.[0-9]+\.[0-9]+$' "$tag"; then
		log "ignoring invalid upgrade request"
		return 0
	fi
	old="$(image)"
	new="$REGISTRY:${tag#v}"
	[ "$old" != "$new" ] || return 0
	log "upgrading $old -> $new"

	status "$tag" "downloading"
	if ! docker image inspect "$new" >/dev/null 2>&1 && ! docker pull -q "$new" >/dev/null; then
		status "$tag" "failed" "download failed, nothing changed"
		return 0
	fi
	bundle="$(mktemp -d)"
	tmp="$(docker create "$new" version)"
	docker cp "$tmp:/appliance" "$bundle/" >/dev/null 2>&1 || true
	docker rm "$tmp" >/dev/null
	before="$(count || true)"

	status "$tag" "backing up"
	systemctl stop rightsizer.service
	file="rightsizer-data-$(date +%Y%m%d-%H%M%S).tar.gz"
	if ! docker run --rm --network none --read-only --cap-drop ALL --security-opt no-new-privileges:true \
		--user "$UID_ENGINE:$UID_ENGINE" --entrypoint /rightsizer \
		-v "$DATA":/data:ro -v "$BACKUPS":/backup "$new" backup "/backup/$file"; then
		systemctl start rightsizer.service
		status "$tag" "failed" "backup failed, nothing changed"
		return 0
	fi

	rm -rf "$PREVIOUS"
	if [ -f "$bundle/appliance/manifest" ]; then
		status "$tag" "updating the appliance"
		if ! bash "$bundle/appliance/root/opt/rightsizer/bin/rightsizer-host" apply "$bundle/appliance" "$PREVIOUS"; then
			restore_host "$PREVIOUS"
			rm -rf "$bundle"
			systemctl start rightsizer.service
			status "$tag" "failed" "the appliance update was refused, nothing changed"
			return 0
		fi
	fi
	rm -rf "$bundle"

	status "$tag" "starting"
	printf 'IMAGE=%s\n' "$new" >"$ENV_FILE.new"
	chmod 0644 "$ENV_FILE.new"
	mv "$ENV_FILE.new" "$ENV_FILE"
	systemctl start rightsizer.service
	after=""
	if ready; then
		after="$(count || true)"
	fi
	if [ -n "$after" ] && { [ -z "$before" ] || [ "$after" -ge "$before" ]; }; then
		status "$tag" "done"
		rm -rf "$PREVIOUS"
		systemctl restart rightsizer-console.service || true
		docker image rm "$old" >/dev/null 2>&1 || true
		log "upgrade to $tag complete"
		return 0
	fi

	log "upgrade to $tag failed, rolling back"
	systemctl stop rightsizer.service
	docker run --rm --network none --read-only --cap-drop ALL --security-opt no-new-privileges:true \
		--user "$UID_ENGINE:$UID_ENGINE" --entrypoint /rightsizer \
		-v "$DATA":/data -v "$BACKUPS":/backup:ro "$old" restore "/backup/$file" ||
		docker run --rm --network none --read-only --cap-drop ALL --security-opt no-new-privileges:true \
			--user "$UID_ENGINE:$UID_ENGINE" --entrypoint /rightsizer \
			-v "$DATA":/data -v "$BACKUPS":/backup:ro "$new" restore "/backup/$file" || true
	restore_host "$PREVIOUS"
	clear_flag upgrade
	printf 'IMAGE=%s\n' "$old" >"$ENV_FILE"
	chmod 0644 "$ENV_FILE"
	systemctl start rightsizer.service
	systemctl restart rightsizer-console.service || true
	status "$tag" "rolled back" "the new version did not start or load all analyses"
}

case "${1:-}" in
network) network ;;
prepare) prepare ;;
engine) engine ;;
upgrade) upgrade ;;
apply) apply "${2:?bundle directory}" "${3:?backup directory}" ;;
os-check) os_check ;;
reboot) reboot_host ;;
*)
	echo "usage: rightsizer-host network|prepare|engine|upgrade|apply|os-check|reboot" >&2
	exit 2
	;;
esac
